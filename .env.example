# Copy to .env (never commit .env). Every value is optional in fixture mode.

# fixture = no keys, recorded suppliers and stub decisions. live = use the keys below.
RUN_MODE=fixture

# QuickBooks dataset: run backend/scripts/fetch_dataset.sh and paste the printed path.
QB_DATA_DIR=

# Jev (TypeSafe). Server-side only.
JEV_API_KEY=
JEV_MODEL=jev-latest

# Step 5 Preview, StepFun direct (the OPENROUTER_ names work with any OpenAI-compatible endpoint).
# Step 5 reasons before it answers; the backend asks for at least 2048 tokens (llm_min_max_tokens).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://api.stepfun.ai/v1
STEP5_MODEL=step-5-preview

# CREAO API Trigger (capi_... key; server-side only).
CREAO_API_KEY=
CREAO_APP_ID=

# Photon 2.0 beta (app.beta.photon.codes): project ID pho_prj_..., API key pho_sk_... (project:read + project:write)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# Legacy alias for the key. Leave blank.
PHOTON_PROJECT_SECRET=
# stream (default, no public URL), poll (no public URL), webhook (needs the tunnel), or off
PHOTON_INBOUND_MODE=stream
PHOTON_POLL_MS=3000
# whsec_... secret of a Photon webhook destination (webhook mode only)
PHOTON_WEBHOOK_SECRET=
# Optional: shared token between backend and the Photon service; extra team phones (comma-separated)
PHOTON_SERVICE_TOKEN=
PHOTON_ALLOWED_PHONES=
# Photon voice number (+E.164) and its Voice profile OUTBOUND SIP login (Voice -> Lines -> profile -> Outbound calls).
# Used once to import the number into ElevenLabs as a SIP trunk. Server-side only.
PHOTON_PHONE_NUMBER=
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=

# ElevenLabs (voice agent over the Photon SIP trunk)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Live transcript tool (services/photon/scripts/setup_live_transcript.py makes the secret and saves the URL)
ELEVENLABS_TOOL_SECRET=
PHOTON_PUBLIC_URL=

# Phones: TEAM phones only
DEMO_DISTRIBUTOR_PHONE=
OWNER_PHONE=

# Networking
PUBLIC_BASE_URL=
BACKEND_URL=http://localhost:8000
PHOTON_SERVICE_URL=http://localhost:8787
# call_first (agent calls the distributor first) or sms_first
DISTRIBUTOR_FLOW=call_first
# The call asks about only this many items (the ones with the most money at stake). 0 = every item.
DISTRIBUTOR_CALL_MAX_ITEMS=1

# Browser Use
BROWSER_USE_API_KEY=
# local (dev, local Chromium) or cloud (demo, Browser Use cloud browser with a live view URL)
BROWSER_MODE=local
# false = visible Chrome windows. WebstaurantStore refuses add-to-cart from a headless browser,
# so local runs with real sites need false (the cloud browser is the demo option).
BROWSER_HEADLESS=false
# Browser Use agent lane model. step-3.7-flash passed the H3 gate (219 s); step-5-preview took ~100 s a step
BROWSER_LLM_MODEL=step-3.7-flash
BROWSER_LLM_FALLBACK=step-3.5-flash
# Hosted agent lane (from Cartwise): with BROWSER_USE_API_KEY set, the Browser Use Cloud agent is the
# lane for sites with no adapter, and the Step 5 agent above is its fallback. false = Step 5 agent first.
HOSTED_AGENT_FIRST=true
# Spend cap in USD for one lane's whole hosted session (all of its runs).
HOSTED_AGENT_MAX_COST_USD=2
# Blank = the Browser Use default model. Its list has no StepFun model.
HOSTED_AGENT_MODEL=

# Sentry (backend). The frontend has its own DSN.
SENTRY_DSN=

# Admin drawer and webhook protection. Change both before the event.
ADMIN_TOKEN=dev-admin
WEBHOOK_SECRET=dev-webhook
# Bearer token for POST /planner/check (the CREAO scheduled run sends it). Required in live mode.
RESTOCK_TOKEN=

# Team-controlled guest checkout details. Never a third party's data.
CHECKOUT_CONTACT__NAME=
CHECKOUT_CONTACT__EMAIL=
CHECKOUT_CONTACT__PHONE=
CHECKOUT_CONTACT__ADDRESS1=
CHECKOUT_CONTACT__CITY=Kalamazoo
CHECKOUT_CONTACT__STATE=MI
CHECKOUT_CONTACT__ZIP=49007

# Timing (seconds). Fixture lanes multiply their simulated work by FIXTURE_TIME_SCALE.
JOB_DEADLINE_S=150
FIXTURE_TIME_SCALE=1.0
